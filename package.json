{
    "name": "grandsvoisins",
    "description": "Les Grands Voisins sur A community-driven effort to make digital accessibility easier.",
    "homepage": "https://www.grandsvoisins.com/",
    "version": "0.0.2-alpha2",
    "license": "Apache-2.0",
    "author": "Chris Mann",
    "type": "module",
    "contributors": [
        "Chris Mann (https://www.mann.fr)",
        "Dave Rupert (https://daverupert.com/)",
        "Carie Fisher (https://www.linkedin.com/in/cehfisher/)",
        "Dennis Gaebel <dennisgaebel@gmail.com> (https://droidpinkman.io/)",
        "Eric Bailey <eric.w.bailey@gmail.com> (https://ericwbailey.design/)",
        "EJ Mason <hey@ejmason.com> (https://ejmason.com/)",
        "Jen Downs (https://jen.dev/)",
        "Jerry Jones (http://jeremyjon.es/)",
        "Saptak Sengupta (https://saptaks.website/)",
        "Scott O'Hara <scottaohara@gmail.com> (https://www.scottohara.me/)",
        "Scott Vinkle <scott.vinkle@shopify.com> (https://svinkle.me/)",
        "Soren Hamby <scott.vinkle@shopify.com> (https://svinkle.me/)",
        "Tatiana Mac (https://tatianamac.com/)",
        "Wayne Elgin (https://twitter.com/esjay)"
    ],
    "engines": {
        "node": ">=16"
    },
    "scripts": {
        "watch:sass": "sass --no-source-map --watch src/css:dist/css",
        "build:sass": "sass --no-source-map src/css:dist/css",
        "build:eleventy": "eleventy",
        "watch:eleventy": "eleventy --serve",
        "clean": "del-cli dist",
        "postbuild": "postcss dist/css/*.css -u autoprefixer cssnano -r",
        "start": "pnpm clean; pnpm build:sass; pnpm run /^watch:.*/",
        "build": "pnpm clean; pnpm run /^build:.*/"
    },
    "keywords": [
        "a11y",
        "lesgrandsvoisins",
        "grandsvoisins",
        "gvois"
    ],
    "packageManager": "pnpm@10.25.0",
    "repository": {
        "type": "git",
        "url": "git://github.com/lesgrandsvoisins/a11yproject.lgv.info"
    },
    "browserslist": [
        "last 2 version",
        "> 0.25%",
        "ie >= 11"
    ],
    "devDependencies": {
        "@11ty/eleventy": "^3.1.2",
        "@11ty/eleventy-img": "^6.0.4",
        "@11ty/eleventy-navigation": "^1.0.5",
        "@11ty/eleventy-plugin-rss": "^2.0.4",
        "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
        "autoprefixer": "^10.4.23",
        "browser-sync": "^3.0.4",
        "cssnano": "^7.1.2",
        "del-cli": "^7.0.0",
        "html-minifier": "^4.0.0",
        "markdown-it": "^14.1.0",
        "markdown-it-anchor": "^9.2.0",
        "markdown-it-footnote": "^4.0.0",
        "normalize.css": "^8.0.1",
        "postcss": "^8.5.6",
        "postcss-cli": "^11.0.1",
        "sass": "^1.97.1",
        "slugify": "^1.6.6",
        "stylelint": "^16.26.1"
    }
}
